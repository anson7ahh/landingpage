
# Secret used by Payload to sign JWT tokens
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET

# Secret used to validate preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET



# Public server URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Node environment
NODE_ENV=development



POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cms

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms
